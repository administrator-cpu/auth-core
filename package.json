{
  "name": "@thediv/auth-core",
  "version": "1.0.0",
  "description": "Headless authentication engine",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  
"files": [
    "dist"
  ],
  "keywords": ["auth", "authentication", "react", "headless-auth", "zustand", "axios"],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/auth-core.git"
  },
  "author": "Harsh Jha",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "axios": "^1.16.1",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
